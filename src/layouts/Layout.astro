---
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import BackToTop from '@components/ui/BackToTop.astro';
import SEO from '@components/SEO.astro';
import Schema from '@components/Schema.astro';
import type { ImageMetadata } from 'astro';

export interface LayoutProps {
	title: string;
	page?: number;
	meta?: {
		title?: string;
		description?: string;
		image?: string | ImageMetadata;
		url?: string;
	};
}

const { title = 'Full-Stack Developer', page, meta } = Astro.props;
const seoTitle = meta?.title ?? `${title} | Suroj Dangol`;
const description =
	meta?.description ??
	'Suroj Dangol is a full-stack developer in Nepal specializing in Java, Spring Boot, React, Flutter, and cloud software for teams worldwide.';
const canonical = meta?.url ?? Astro.url.pathname;
const image =
	typeof meta?.image === 'string' ? meta.image : (meta?.image?.src ?? '/images/surojd.jpg');
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Suroj Dangol',
	url: new URL('/', Astro.site ?? 'https://surojd.com').href,
	jobTitle: 'Full-Stack Developer and Software Consultant',
	description:
		'Suroj Dangol is a full-stack developer in Nepal specializing in Java, Spring Boot, React, Flutter, and cloud software for teams worldwide.',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Lalitpur',
		addressCountry: 'NP',
	},
	knowsAbout: [
		'Java',
		'Spring Boot',
		'React',
		'Flutter',
		'AWS',
		'SaaS development',
		'WordPress',
		'Linux administration',
		'Payment gateway integration',
		'Software architecture',
	],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-testid="html">
	<head>
		<meta charset="UTF-8" />
		<SEO
			title={seoTitle}
			description={description}
			canonical={canonical}
			image={image}
		/>
		<Schema schema={personSchema} />
		<meta name="author" content="Suroj Dangol" />
		<meta name="theme-color" content="#000000" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon.png" />
		<slot name="head" />
		<link rel="dns-prefetch" href="//www.googletagmanager.com" />
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<!-- Google Tag Manager (deferred) -->
		<script is:inline defer>
			window.addEventListener('DOMContentLoaded', () => {
				let loaded = false;
				function loadGTM() {
					if (loaded) return;
					loaded = true;
					const script = document.createElement('script');
					script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-MQXQFWX';
					script.defer = true;
					document.head.appendChild(script);
				}
				setTimeout(loadGTM, 3000);
				window.addEventListener('click', loadGTM, { once: true });
			});
		</script>
		<!-- End Google Tag Manager (deferred) -->
	</head>
	<body
		class="mx-auto max-w-screen-xl bg-white font-sans text-black dark:bg-black dark:text-white xs:text-[16px] md:text-[18px]"
	>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-MQXQFWX"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->
		<Navbar nav="topnav" page={page ?? 0} />

		<slot />
		<Contact />
		<BackToTop />
		<Footer />

		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>
