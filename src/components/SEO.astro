---
interface Props {
	title: string;
	description: string;
	canonical: string;
	image: string;
	noindex?: boolean;
}

const { title, description, canonical, image, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://surojd.com');
const canonicalUrl = new URL(canonical, site).href;
const imageUrl = new URL(image, site).href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Suroj Dangol" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@SurojDangol" />
<meta name="twitter:creator" content="@SurojDangol" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />
